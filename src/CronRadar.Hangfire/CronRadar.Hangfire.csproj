<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar.Hangfire</PackageId>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Product>CronRadar Hangfire Extension</Product>
    <Description>Detect missed, failed, stuck, and disappeared Hangfire recurring jobs with automatic registry discovery, schedule sync, and lifecycle tracking.</Description>
    <Copyright>Copyright © CronRadar 2026</Copyright>
    <PackageProjectUrl>https://cronradar.com/hangfire</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-hangfire</RepositoryUrl>
    <PackageTags>cronradar;hangfire;recurring-jobs;monitoring;missed-jobs;failed-jobs;stuck-jobs;scheduler;alerts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Clarifies recurring-job reliability coverage and package discovery metadata; runtime behavior is unchanged.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\cronradar-dotnet\src\CronRadar\CronRadar.csproj" />
    <PackageReference Include="Hangfire.Core" Version="1.8.21" />
    <!-- Hangfire.Core allows Newtonsoft.Json 11.0.1 (GHSA-5crp-9r3c-p9vr); 13.0.1 is the patched floor -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
