<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar.Hangfire</PackageId>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Product>CronRadar Hangfire Extension</Product>
    <Description>Automatic discovery, schedule synchronization, and lifecycle monitoring for Hangfire recurring jobs.</Description>
    <Copyright>Copyright © CronRadar 2026</Copyright>
    <PackageProjectUrl>https://cronradar.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-hangfire</RepositoryUrl>
    <PackageTags>cronradar;hangfire;monitoring;background-jobs;scheduler;cron;job-monitoring;alerts;devops</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>AddCronRadarHangfire provides startup and periodic discovery, final-attempt failure reporting, and safe removal reconciliation.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\cronradar-dotnet\src\CronRadar\CronRadar.csproj" />
    <PackageReference Include="Hangfire.Core" Version="1.8.21" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
